<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Baby Shower</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&family=Playfair+Display:wght@400&family=Quicksand:wght@600&display=swap" rel="stylesheet">
<style>
  :root{
    --ivory: #F6F2E9;
    --card: #FCFAF4;
    --olive: #5D5C41;
    --olive-soft: #8B8968;
    --olive-whisper: #DDDCC6;
    --sage-tint: #EDEFE0;
    --ink: #3E382E;
    --ink-soft: #6E6553;
    --sand: #C9A15A;
    --sand-tint: #F5EDDA;
    --blush: #D8A18C;
    --blush-tint: #F7EAE2;
    --fur: #F2DCB0;
    --fur-deep: #E3BE7E;
    --mane: #D9A55F;
  }
  *{ box-sizing:border-box; margin:0; }

  body{
    background: var(--ivory);
    background-image:
      radial-gradient(ellipse 520px 420px at 112% -6%, rgba(201,161,90,0.12), transparent 62%),
      radial-gradient(ellipse 520px 520px at -12% 106%, rgba(139,137,104,0.14), transparent 62%),
      radial-gradient(ellipse 400px 400px at 50% 50%, rgba(201,161,90,0.05), transparent 70%);
    font-family:'Jost', sans-serif;
    color: var(--ink);
    display:flex;
    justify-content:center;
    padding: 34px 16px 70px;
    -webkit-font-smoothing:antialiased;
  }

  .invite{ width:100%; max-width: 540px; }

  /* ================= HERO ARCH ================= */
  .arch-card{
    background: linear-gradient(180deg, #FDFBF5 0%, #FAF6EA 100%);
    border: 1px solid rgba(93,92,65,0.24);
    border-radius: 270px 270px 26px 26px;
    padding: 58px 34px 46px;
    text-align:center;
    position:relative;
    box-shadow: 0 24px 60px -30px rgba(62,56,46,0.28);
  }
  .arch-card::before{
    content:"";
    position:absolute;
    inset: 10px;
    border: 1px solid rgba(201,161,90,0.5);
    border-radius: 260px 260px 18px 18px;
    pointer-events:none;
  }

  .over-title{
    font-weight:600;
    font-size: 17px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--sand);
    text-indent: 0.42em;
  }

  h1{
    font-family:'Cormorant Garamond', serif;
    font-weight:500;
    font-size: 54px;
    line-height: 1.02;
    color: var(--olive);
    margin: 14px 0 4px;
  }
  h1 em{ font-style:italic; font-weight:400; color:#6d6b49; }

  .lion-frame{
    width: 250px;
    margin: 24px auto 20px;
  }
  .lion-frame img{ width:100%; display:block; filter: drop-shadow(0 6px 14px rgba(62,56,46,0.14)); }

  .hero-quote{
    font-family:'Cormorant Garamond', serif;
    font-style:italic;
    font-size: 23px;
    line-height:1.5;
    color: var(--ink-soft);
    max-width: 380px;
    margin: 0 auto;
  }
  .hero-quote .hq-heart{ color: var(--sand); }

  .rule{
    display:flex;
    align-items:center;
    gap: 14px;
    margin: 26px auto 24px;
    max-width: 250px;
  }
  .rule::before, .rule::after{
    content:"";
    flex:1;
    height:1px;
    background: rgba(201,161,90,0.55);
  }
  .rule svg{ width:13px; height:13px; flex-shrink:0; }

  .date-line{
    display:flex;
    justify-content:center;
    align-items:baseline;
    gap: 26px;
  }
  .date-side{
    font-weight:400;
    font-size: 15px;
    letter-spacing: 0.3em;
    text-transform:uppercase;
    color: var(--ink-soft);
    text-indent:0.3em;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(201,161,90,0.65);
  }
  .date-num{
    font-family:'Playfair Display', serif;
    font-weight:400;
    font-size: 76px;
    line-height: 0.8;
    color: var(--olive);
  }

  .time-place{
    margin-top: 20px;
    font-family:'Cormorant Garamond', serif;
    font-size: 25px;
    color: var(--ink);
    line-height:1.55;
  }
  .time-place .hora{
    font-weight:500;
    font-size: 27px;
    color: var(--olive);
  }
  .time-place .num, .time-place .hora{
    font-family:'Playfair Display', serif;
  }
  .time-place .num{
    font-weight:400;
    font-size: 0.9em;
  }

  .map-link{
    display:inline-flex;
    align-items:center;
    gap:8px;
    margin-top: 16px;
    font-weight:500;
    font-size: 15px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color: var(--olive);
    text-decoration:none;
    border-bottom: 1px solid var(--sand);
    padding-bottom: 3px;
    text-indent:0.14em;
    transition: all .15s ease;
  }
  .map-link:hover{ color: var(--ink); border-color: var(--ink); }

  /* ================= SECTIONS ================= */
  .section{
    margin-top: 26px;
    background: var(--card);
    border: 1px solid rgba(93,92,65,0.22);
    border-radius: 22px;
    padding: 42px 34px 40px;
    position:relative;
    box-shadow: 0 20px 50px -32px rgba(62,56,46,0.24);
    overflow:hidden;
  }
  .section.gifts{
    background: linear-gradient(180deg, #FCFAF4 0%, var(--sand-tint) 130%);
  }
  .section.rsvp{
    background: linear-gradient(180deg, #FCFAF4 0%, var(--sage-tint) 130%);
  }

  .sec-eyebrow{
    text-align:center;
    font-weight:500;
    font-size: 12px;
    letter-spacing:0.4em;
    text-transform:uppercase;
    color: var(--sand);
    text-indent:0.4em;
    margin-bottom: 8px;
  }
  .section h2{
    font-family:'Cormorant Garamond', serif;
    font-weight:500;
    font-size: 38px;
    line-height:1.05;
    text-align:center;
    color: var(--olive);
    margin-bottom: 10px;
  }
  .sec-note{
    font-family:'Cormorant Garamond', serif;
    font-style:italic;
    font-size: 20px;
    line-height:1.5;
    text-align:center;
    color: var(--ink-soft);
    max-width: 360px;
    margin: 0 auto 28px;
  }

  /* form */
  label{
    display:block;
    font-weight:500;
    font-size: 14px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 10px;
    text-indent:0.18em;
  }
  input[type="text"]{
    width:100%;
    font-family:'Cormorant Garamond', serif;
    font-size: 24px;
    padding: 13px 4px;
    border:none;
    border-bottom: 1.5px solid rgba(93,92,65,0.4);
    background: transparent;
    color: var(--ink);
    margin-bottom: 28px;
    border-radius:0;
  }
  input[type="text"]::placeholder{ color: #B4AC98; font-style:italic; }
  input[type="text"]:focus{
    outline:none;
    border-bottom-color: var(--olive);
    box-shadow: 0 1.5px 0 var(--olive);
  }

  .choice-group{ display:flex; gap: 14px; margin-bottom: 30px; }
  .choice-btn{
    flex:1;
    font-family:'Jost', sans-serif;
    font-weight:500;
    font-size: 16px;
    letter-spacing:0.06em;
    padding: 17px 8px;
    background: #fff;
    border: 1.5px solid rgba(93,92,65,0.35);
    border-radius: 999px;
    color: var(--ink-soft);
    cursor:pointer;
    transition: all .18s ease;
  }
  .choice-btn:hover{ border-color: var(--olive); color: var(--olive); }
  .choice-btn.selected{
    background: var(--olive);
    border-color: var(--olive);
    color: var(--card);
  }
  .choice-btn.no.selected{
    background: #8B8968;
    border-color: #8B8968;
    color:#fff;
  }

  .primary-btn{
    width:100%;
    font-weight:500;
    font-size: 16px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-indent:0.22em;
    padding: 19px;
    background: var(--olive);
    color: #F4F2E8;
    border: 1.5px solid var(--olive);
    border-radius: 999px;
    cursor:pointer;
    transition: all .18s ease;
    font-family:'Jost', sans-serif;
  }
  .primary-btn:hover{ background: #4d4c35; }
  .primary-btn:active{ transform: translateY(1px); }
  .primary-btn:disabled{ opacity:.5; cursor:not-allowed; }

  .wa-hint{
    margin-top: 16px;
    text-align:center;
    font-size: 15px;
    font-weight:300;
    color: var(--ink-soft);
    line-height:1.5;
  }
  .choice-btn.persona.selected{
    background: var(--sand);
    border-color: #B68C46;
    color:#fff;
  }
  .confirm-msg, .error-msg{
    display:none;
    margin-top: 20px;
    text-align:center;
    font-family:'Cormorant Garamond', serif;
    font-size: 21px;
    font-style:italic;
    line-height:1.45;
  }
  .confirm-msg{ color: var(--olive); }
  .error-msg{ color: #B0684C; font-size:18px; }
  .show{ display:block; }

  /* gifts */
  .gift-row{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .gift{
    padding: 24px 16px 26px;
    text-align:center;
    border-radius: 18px;
    background: rgba(237,239,224,0.55);
    border: 1px solid rgba(139,137,104,0.28);
    display:flex;
    flex-direction:column;
    align-items:center;
  }
  .gift p{ flex:1; }
  @media (max-width: 460px){
    .gift-row{ grid-template-columns: 1fr; }
  }

  .gift h3{
    font-family:'Cormorant Garamond', serif;
    font-weight:600;
    font-size: 27px;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .gift h3 .dot{ color: var(--sand); }
  .gift p{
    font-weight:300;
    font-size: 17px;
    line-height:1.6;
    color: var(--ink-soft);
    max-width: 340px;
    margin: 0 auto 16px;
  }
  .gift p b{ font-weight:600; color: var(--ink); font-size:18px;}

  .ghost-btn, .solid-btn{
    display:inline-block;
    font-family:'Jost', sans-serif;
    font-weight:500;
    font-size: 14px;
    letter-spacing:0.2em;
    text-transform:uppercase;
    text-indent:0.2em;
    padding: 14px 22px;
    border-radius: 999px;
    cursor:pointer;
    text-decoration:none;
    transition: all .18s ease;
  }
  .ghost-btn{
    background:#fff;
    border: 1.5px solid var(--olive);
    color: var(--olive);
  }
  .ghost-btn:hover, .ghost-btn.copied{ background: var(--olive); color: var(--card); }
  .solid-btn{
    background: var(--olive);
    border: 1.5px solid var(--olive);
    color: #F4F2E8;
  }
  .solid-btn:hover{ background:#4d4c35; }

  .yape-num{
    font-family:'Quicksand', sans-serif;
    font-weight:600;
    font-size: 22px;
    letter-spacing:0.1em;
    color: var(--olive);
    margin: 0 0 16px;
  }
  .gift .qr{
    width: 100%;
    max-width: 190px;
    border-radius: 14px;
    border: 1px solid rgba(93,92,65,0.25);
    margin: 2px auto 10px;
    display:block;
  }
  .gift .qr-name{
    font-weight:500 !important;
    color: var(--ink) !important;
    font-size: 17px !important;
    margin-bottom: 6px !important;
    flex:0 !important;
  }

  .foot{ text-align:center; margin-top: 40px; }
  .foot .sprig{ width:70px; margin:0 auto 12px; display:block; }
  .foot p{
    font-family:'Cormorant Garamond', serif;
    font-style:italic;
    font-size: 24px;
    color: var(--ink-soft);
  }


  @media (max-width: 430px){
    h1{ font-size: 44px; }
    .date-num{ font-size: 68px; }
    .date-line{ gap: 16px; }
    .arch-card{ padding: 48px 22px 38px; }
    .section{ padding: 36px 22px 34px; }
  }
  @media (prefers-reduced-motion: reduce){
    *{ transition:none !important; animation:none !important; }
  }
</style>
</head>
<body>
<div class="invite">

  <!-- ================= HERO ================= -->
  <div class="arch-card">
    <div class="over-title">Baby Shower</div>
    <h1>Alguien muy<br><em>pequeñito</em><br>está en camino</h1>

    <div class="lion-frame">
      <img src="data:image/png;base64," alt="Familia de leones">
    </div>

    <p class="hero-quote">Estamos a la espera de un momento hermoso, y queremos vivirlo junto a quienes más queremos <span class="hq-heart">♥</span></p>

    <div class="rule">
      <svg viewBox="0 0 24 24"><path d="M12 0 l2.6 9.4 L24 12 l-9.4 2.6 L12 24 l-2.6-9.4 L0 12 l9.4-2.6z" fill="#C9A15A"/></svg>
    </div>

    <div class="date-line">
      <div class="date-side">Sábado</div>
      <div class="date-num">10</div>
      <div class="date-side">Octubre</div>
    </div>

    <div class="time-place">
      a las <span class="hora">3:00 p.m.</span><br>
      Av. Parra <span class="num">102</span> · Arequipa
    </div>

    <a class="map-link" href="https://maps.app.goo.gl/wzULHh55cs9Rycm48" target="_blank" rel="noopener">Ver ubicación</a>
  </div>

  <!-- ================= GIFTS (primero) ================= -->
  <div class="section gifts">
    <div class="sec-eyebrow">Regalos</div>
    <h2>Un detalle para el bebé</h2>
    <p class="sec-note">Tu compañía es nuestro mejor regalo. Pero si deseas darle un detallito al bebé, puedes hacerlo de dos maneras:</p>

    <div class="gift-row">
      <div class="gift">
        <h3><span class="dot">♥</span> Por Yape</h3>
        <img class="qr" loading="lazy" src="data:image/png;base64," alt="Código QR de Yape">
        <p class="qr-name">Fronthy Linares</p>
        <div class="yape-num">964 285 800</div>
        <button type="button" class="ghost-btn" id="btnCopiar">Copiar número</button>
      </div>

      <div class="gift">
        <h3><span class="dot">❀</span> Lista de regalos</h3>
        <p>Armamos una lista con algunas ideas, por si prefieres elegir algo de ahí.</p>
        <a class="solid-btn" href="https://sinenvolturas.com/leonardo" target="_blank" rel="noopener">Ver la lista</a>
      </div>
    </div>
  </div>

  <!-- ================= RSVP ================= -->
  <div class="section rsvp">
    <div class="sec-eyebrow">Confirma tu asistencia</div>
    <h2>¿Nos acompañas?</h2>
    <p class="sec-note">Cuéntanos si podrás venir, para guardarte un lugar.</p>

    <label for="nombre">Tu nombre</label>
    <input type="text" id="nombre" placeholder="Escribe tu nombre y apellido">

    <label>¿Podrás venir?</label>
    <div class="choice-group">
      <button type="button" class="choice-btn" id="btnSi">Sí, ahí estaré</button>
      <button type="button" class="choice-btn no" id="btnNo">No podré ir</button>
    </div>

    <label>¿A quién le avisas?</label>
    <div class="choice-group">
      <button type="button" class="choice-btn persona" id="btnPaul">A Paúl</button>
      <button type="button" class="choice-btn persona" id="btnFronthy">A Fronthy</button>
    </div>

    <button type="button" class="primary-btn" id="btnConfirmar">Confirmar por WhatsApp</button>
    <div class="error-msg" id="errorMsg"></div>
    <p class="wa-hint">Se abrirá tu WhatsApp con el mensaje listo, solo tienes que enviarlo.</p>
  </div>

  <!-- ================= FOOT ================= -->
  <div class="foot">
    <svg class="sprig" viewBox="0 0 70 26" fill="none">
      <path d="M5 20 q30-15 60 0" stroke="#9AA37E" stroke-width="1.3" stroke-linecap="round"/>
      <g fill="#BBC49C">
        <ellipse cx="16" cy="14" rx="2.3" ry="5.2" transform="rotate(-30 16 14)"/>
        <ellipse cx="28" cy="9.6" rx="2.3" ry="5.2" transform="rotate(-12 28 9.6)"/>
        <ellipse cx="42" cy="9.6" rx="2.3" ry="5.2" transform="rotate(12 42 9.6)"/>
        <ellipse cx="54" cy="14" rx="2.3" ry="5.2" transform="rotate(30 54 14)"/>
      </g>
      <path d="M35 10 l1.7 4.3 4.3 1.7 -4.3 1.7 -1.7 4.3 -1.7-4.3 -4.3-1.7 4.3-1.7z" fill="#C9A15A"/>
      <path d="M12 6 c-1-1.9 1.9-3 2.5-1 c.6-2 3.5-.9 2.5 1 c-.75 1.5-2.5 2.5-2.5 2.5 s-1.75-1-2.5-2.5z" fill="#C9A15A" opacity=".8"/>
      <path d="M56 5 c-.8-1.5 1.5-2.4 2-.8 c.5-1.6 2.8-.7 2 .8 c-.6 1.2-2 2-2 2 s-1.4-.8-2-2z" fill="#C9A15A" opacity=".7"/>
    </svg>
    <p>Con todo nuestro cariño, te esperamos.</p>
  </div>
</div>

<script>
  let asistencia = null;
  let destino = null;

  const NUMEROS = { paul: '51959205585', fronthy: '51964285800' };

  const btnSi = document.getElementById('btnSi');
  const btnNo = document.getElementById('btnNo');
  const btnPaul = document.getElementById('btnPaul');
  const btnFronthy = document.getElementById('btnFronthy');
  const errorMsg = document.getElementById('errorMsg');
  const nombreInput = document.getElementById('nombre');

  btnSi.addEventListener('click', () => {
    asistencia = 'si';
    btnSi.classList.add('selected');
    btnNo.classList.remove('selected');
  });
  btnNo.addEventListener('click', () => {
    asistencia = 'no';
    btnNo.classList.add('selected');
    btnSi.classList.remove('selected');
  });
  btnPaul.addEventListener('click', () => {
    destino = 'paul';
    btnPaul.classList.add('selected');
    btnFronthy.classList.remove('selected');
  });
  btnFronthy.addEventListener('click', () => {
    destino = 'fronthy';
    btnFronthy.classList.add('selected');
    btnPaul.classList.remove('selected');
  });

  document.getElementById('btnConfirmar').addEventListener('click', () => {
    const nombre = nombreInput.value.trim();
    errorMsg.classList.remove('show');

    if (!nombre){
      errorMsg.textContent = 'Por favor escribe tu nombre.';
      errorMsg.classList.add('show');
      return;
    }
    if (!asistencia){
      errorMsg.textContent = 'Elige si podrás venir o no.';
      errorMsg.classList.add('show');
      return;
    }
    if (!destino){
      errorMsg.textContent = 'Elige a quién le avisas: Paúl o Fronthy.';
      errorMsg.classList.add('show');
      return;
    }

    const mensaje = asistencia === 'si'
      ? '¡Hola! Soy ' + nombre + ' y confirmo mi asistencia al baby shower \u{1F49B}'
      : '¡Hola! Soy ' + nombre + '. Lamentablemente no podré asistir al baby shower, ¡les mando un abrazo enorme! \u{1F49B}';

    const url = 'https://wa.me/' + NUMEROS[destino] + '?text=' + encodeURIComponent(mensaje);
    window.open(url, '_blank');
  });

  document.getElementById('btnCopiar').addEventListener('click', async () => {
    const btn = document.getElementById('btnCopiar');
    try {
      await navigator.clipboard.writeText('964285800');
      btn.textContent = 'Número copiado ✓';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = 'Copiar número';
        btn.classList.remove('copied');
      }, 2200);
    } catch (e) {
      btn.textContent = '964 285 800';
    }
  });
</script>
</body>
</html>
